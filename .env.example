DATABASE_URL="postgresql://clinic:clinic_dev_pw@localhost:5544/ddu_clinic?schema=public"
AUTH_SECRET="generate-with: npx auth secret"
# AUTH_TRUST_HOST lets Auth.js derive the URL from the request, so login redirects
# follow whatever port you run on. Do NOT set NEXTAUTH_URL/AUTH_URL in local dev —
# a hardcoded value pins every auth redirect to that one port. Set it only in a
# fixed production deployment (e.g. AUTH_URL="https://clinic.ddu.edu.et").
AUTH_TRUST_HOST=true
APP_NAME="DDU Clinic"
APP_ENV=development
SIMS_PROVIDER=mock
SIMS_BASE_URL=""
SIMS_API_KEY=""

# --- Saba AI assistant (OpenAI-compatible: Groq / OpenAI / Ollama) ---
# Enable the "ai.assistant" feature flag in Settings, then configure a provider:
SABA_PROVIDER=groq
SABA_API_KEY=""            # your provider key (not needed for local Ollama)
SABA_MODEL="openai/gpt-oss-120b"
# SABA_BASE_URL=""         # override the endpoint (Ollama: http://localhost:11434/v1)
